 "people": [
  {
   "id": "liu",
   "name": "柳承安",
   "sprite": "elder",
   "person": "liu",
   "lines": [
    [
     {
      "speaker": "柳承安",
      "text": "今年雨水多，竹筍長得特別好。"
     },
     {
      "speaker": "柳承安",
      "text": "{稱}要是不嫌棄，改天讓青禾給你送一籃。"
     }
    ],
    [
     {
      "speaker": "柳承安",
      "text": "{稱}，在青竹村還住得慣嗎？"
     },
     {
      "speaker": "柳承安",
      "text": "這裡雖然偏僻，人情倒是厚的。"
     }
    ],
    [
     {
      "speaker": "柳承安",
      "text": "今年的竹筍長得特別好，回頭讓鍾嬸給你燉一鍋。"
     }
    ],
    [
     {
      "speaker": "柳承安",
      "text": "村東那座木橋該修修了，下雨天走著打滑。"
     }
    ],
    [
     {
      "speaker": "柳承安",
      "text": "老井的水喝了幾十年，還是那麼甜。"
     }
    ],
    [
     {
      "speaker": "柳承安",
      "text": "{稱}有空多去茶寮坐坐，葛先生的書說得好。"
     }
    ]
   ],
   "script": "qingzhu/liu_talk"
  },
  {
   "id": "zhong",
   "name": "鍾嬸",
   "sprite": "aunt",
   "person": "zhong",
   "lines": [
    [
     {
      "speaker": "鍾嬸",
      "text": "這茶攤擺了二十年囉，從小芸還在吃奶的時候就開始了。"
     }
    ],
    [
     {
      "speaker": "鍾嬸",
      "text": "我家這茶，用的是雲水河上游的水，別處喝不到的。"
     }
    ],
    [
     {
      "speaker": "鍾嬸",
      "text": "今天的茶葉是新炒的，香吧？"
     }
    ],
    [
     {
      "speaker": "鍾嬸",
      "text": "剛才有個貨郎說，南邊的路上又看到狼了。"
     }
    ],
    [
     {
      "speaker": "鍾嬸",
      "text": "秦老漢昨天釣了一條這麼大的魚！我看八成是吹的。"
     }
    ],
    [
     {
      "speaker": "鍾嬸",
      "text": "天要轉涼了，{稱}記得添件衣裳。"
     }
    ]
   ],
   "script": "qingzhu/zhong_talk"
  },
  {
   "id": "shi",
   "name": "石岳",
   "sprite": "smith",
   "person": "shi",
   "lines": [
    [
     {
      "speaker": "石岳",
      "text": "打鐵講究的是火候和耐性，急不得。"
     }
    ],
    [
     {
      "speaker": "石岳",
      "text": "要打一把好刀，得看鐵，也得看人。"
     }
    ]
   ]
  },
  {
   "id": "kid",
   "name": "小石頭",
   "sprite": "child",
   "person": "",
   "lines": [
    [
     {
      "text": "小石頭朝你點點頭，又忙自己的事去了。"
     }
    ]
   ],
   "script": "qingzhu/kid_talk"
  },
  {
   "id": "aniu",
   "name": "阿牛",
   "sprite": "farmer",
   "person": "",
   "lines": [
    [
     {
      "text": "阿牛朝你點點頭，又忙自己的事去了。"
     }
    ]
   ],
   "script": "qingzhu/aniu_talk"
  },
  {
   "id": "du",
   "name": "杜大樑",
   "sprite": "carpenter",
   "person": "",
   "lines": [
    [
     {
      "text": "杜大樑朝你點點頭，又忙自己的事去了。"
     }
    ]
   ]
  },
  {
   "id": "tao",
   "name": "陶四",
   "sprite": "peddler",
   "person": "tao",
   "lines": [
    [
     {
      "speaker": "陶四",
      "text": "我陶四走過的路，比你吃過的米還多——這話不是吹的。"
     }
    ],
    [
     {
      "speaker": "陶四",
      "text": "走過路過不要錯過！傷藥、茶葉、草藥，樣樣都有。"
     },
     {
      "speaker": "陶四",
      "text": "打到的獸皮、獸肉也可以賣給我，價錢公道！（按 T 交易）"
     }
    ],
    [
     {
      "speaker": "陶四",
      "text": "今天想買點什麼？"
     }
    ],
    [
     {
      "speaker": "陶四",
      "text": "臨江城的布價又漲了，這生意越來越難做。"
     }
    ],
    [
     {
      "speaker": "陶四",
      "text": "下個月我要往南邊走一趟，有什麼要捎的儘管說。"
     }
    ]
   ]
  },
  {
   "id": "tong",
   "name": "童老根",
   "sprite": "fisher",
   "person": "",
   "lines": [
    [
     {
      "speaker": "童老根",
      "text": "人老了，除了釣魚，也沒什麼別的嗜好囉。"
     }
    ]
   ]
  },
  {
   "id": "qinghe",
   "name": "柳青禾",
   "sprite": "girl",
   "person": "qinghe",
   "lines": [
    [
     {
      "speaker": "柳青禾",
      "text": "爺爺又在書房看那本舊拳譜了……他以為我不知道。"
     }
    ],
    [
     {
      "speaker": "柳青禾",
      "text": "你就是那個從外地來的人？"
     },
     {
      "speaker": "柳青禾",
      "text": "我叫柳青禾，村長是我爺爺。"
     }
    ]
   ]
  },
  {
   "id": "wangsao",
   "name": "王嫂",
   "sprite": "lady",
   "person": "",
   "lines": [
    [
     {
      "speaker": "王嫂",
      "text": "噓，小聲點，娃兒好不容易才睡著。"
     }
    ],
    [
     {
      "speaker": "王嫂",
      "text": "我家那口子是阿牛，整天在田裡忙。"
     },
     {
      "speaker": "王嫂",
      "text": "他啊，心思全在莊稼上，連娃兒哭都聽不見。"
     }
    ],
    [
     {
      "speaker": "王嫂",
      "text": "北邊山上不太平，阿牛上山砍柴，我總要提心吊膽一整天。"
     }
    ]
   ]
  },
  {
   "id": "zou",
   "name": "鄒老實",
   "sprite": "farmer",
   "person": "",
   "lines": [
    [
     {
      "speaker": "鄒老實",
      "text": "這幾畝地是我家的。今年雨水好，秧苗長得旺。"
     }
    ],
    [
     {
      "speaker": "鄒老實",
      "text": "往北走就上蒼嵐山了。以前山上有山賊，現在聽說太平多啦。"
     }
    ]
   ]
  }
 ],
